# ============================================
# TrendMint — Environment Variables
# Copy this to .env and fill in your keys
# ============================================

# --- Amazon Product Advertising API (PAAPI 5.0) ---
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# --- Twitter/X API v2 ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# --- Reddit API ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- OpenAI ---
OPENAI_API_KEY=

# --- ClickBank (optional — Phase 2) ---
CLICKBANK_DEV_KEY=
CLICKBANK_CLERK_KEY=

# --- Server ---
PORT=3001
NODE_ENV=development
